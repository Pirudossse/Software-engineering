{
  "info": {
    "name": "Appointments API — DEVOPS-20",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Créer un rendez-vous — champ manquant",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:3000/api/appointments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"doctor\": \"Dr. Lee\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 400 : champ manquant\", function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Un message d’erreur est renvoyé\", function () {",
              "  pm.expect(pm.response.json()).to.have.property(\"error\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Créer un rendez-vous — valide",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:3000/api/appointments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"doctor\": \"Dr. Lee\",\n  \"patient\": \"Alice\",\n  \"date\": \"2026-11-10T14:00:00Z\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 201 : rendez-vous créé\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Le rendez-vous contient les bonnes données\", function () {",
              "  const data = pm.response.json();",
              "  pm.expect(data.id).to.be.a(\"number\");",
              "  pm.expect(data.doctor).to.eql(\"Dr. Lee\");",
              "  pm.expect(data.patient).to.eql(\"Alice\");",
              "  pm.expect(data.date).to.eql(\"2026-11-10T14:00:00Z\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Consulter les rendez-vous — GET",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:3000/api/appointments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"La réponse est un tableau\", function () {",
              "  pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
