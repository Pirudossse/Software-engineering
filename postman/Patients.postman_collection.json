{
  "info": {
    "name": "Healthcare API Tests",
    "description": "Lab 5 - Postman tests for the Healthcare API. Start the server with `npm run dev` before running the collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Patients",
      "item": [
        {
          "name": "GET /api/patients",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/patients"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array\", function () {",
                  "  pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Each patient has id, name and age\", function () {",
                  "  pm.response.json().forEach(function (p) {",
                  "    pm.expect(p).to.have.property(\"id\");",
                  "    pm.expect(p).to.have.property(\"name\");",
                  "    pm.expect(p).to.have.property(\"age\");",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/patients",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Marie\",\n  \"age\": 29\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/patients"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"New patient has an id and the sent data\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property(\"id\");",
                  "  pm.expect(body.name).to.eql(\"Marie\");",
                  "  pm.expect(body.age).to.eql(29);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/patients - missing field (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"No Age\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/patients"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Response has an error message\", function () {",
                  "  pm.expect(pm.response.json()).to.have.property(\"error\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/patients - invalid age (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad\",\n  \"age\": -3\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/patients"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
